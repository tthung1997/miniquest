[sub_resource type="InputEventJoypadButton" id="StartJoypadButton"]
button_index = 0

[sub_resource type="Shortcut" id="StartShortcut"]
events = [SubResource("StartJoypadButton")]

[node name="TitleScreen" type="Control"]
layout_mode = 3
