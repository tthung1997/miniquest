[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/advance_option.gd" id="1_option"]

[node name="AdvanceOption" type="PanelContainer"]
custom_minimum_size = Vector2(160, 0)
size_flags_horizontal = 3
theme_type_variation = &"InteriorPanel"
script = ExtResource("1_option")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="NameLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
theme_override_font_sizes/font_size = 16
text = "Class"
horizontal_alignment = 1

[node name="GrowthLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3

[node name="DescriptionLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_type_variation = &"MutedLabel"
autowrap_mode = 3

[node name="RequirementLabel" type="Label" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
horizontal_alignment = 1
autowrap_mode = 3

[node name="ChooseButton" type="Button" parent="Content"]
unique_name_in_owner = true
layout_mode = 2
text = "BECOME"
