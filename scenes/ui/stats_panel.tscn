[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/stats_panel.gd" id="1_panel"]
[ext_resource type="Theme" path="res://resources/ui/wood_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/stat_row.tscn" id="3_row"]

[node name="StatsPanel" type="VBoxContainer"]
theme = ExtResource("2_theme")
theme_override_constants/separation = 2
script = ExtResource("1_panel")
stat_row_scene = ExtResource("3_row")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="FreePointsLabel" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"AccentLabel"
text = "Free points: --"

[node name="ResetButton" type="Button" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
tooltip_text = "Take back every waiting point"
text = "RESET"

[node name="ApplyButton" type="Button" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
tooltip_text = "Spend the waiting points for good"
text = "APPLY"

[node name="StatGrid" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 2
columns = 2

[node name="Divider" type="ColorRect" parent="."]
custom_minimum_size = Vector2(0, 1)
layout_mode = 2
mouse_filter = 2
color = Color(0.804, 0.776, 0.69, 0.25)

[node name="StatsGrid" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 4
theme_override_constants/v_separation = 2
columns = 3
