[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/stats_panel.gd" id="1_panel"]
[ext_resource type="Theme" path="res://resources/ui/wood_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/stat_row.tscn" id="3_row"]

[node name="StatsPanel" type="VBoxContainer"]
theme = ExtResource("2_theme")
theme_override_constants/separation = 2
script = ExtResource("1_panel")
stat_row_scene = ExtResource("3_row")

[node name="Header" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="FreePointsLabel" type="Label" parent="Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"AccentLabel"
text = "Free points: --"

[node name="ResetButton" type="Button" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
tooltip_text = "Take back every waiting point"
text = "RESET"

[node name="ApplyButton" type="Button" parent="Header"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 18)
layout_mode = 2
tooltip_text = "Spend the waiting points for good"
text = "APPLY"

[node name="StatGrid" type="GridContainer" parent="."]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 2
columns = 2

[node name="Readouts" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 4

[node name="HealthLabel" type="Label" parent="Readouts"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Maximum health"
mouse_filter = 1
text = "HP --"
horizontal_alignment = 1

[node name="DamageLabel" type="Label" parent="Readouts"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Damage per hit with the held weapon"
mouse_filter = 1
text = "DMG --"
horizontal_alignment = 1

[node name="SpeedLabel" type="Label" parent="Readouts"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Attacks per second with the held weapon"
mouse_filter = 1
text = "SPD --"
horizontal_alignment = 1

[node name="RangeLabel" type="Label" parent="Readouts"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Attack range of the held weapon"
mouse_filter = 1
text = "RNG --"
horizontal_alignment = 1

[node name="MoveLabel" type="Label" parent="Readouts"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 12)
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Move speed, compared with a hero wearing no boots"
mouse_filter = 1
text = "MOV --"
horizontal_alignment = 1
