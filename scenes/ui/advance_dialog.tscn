[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/advance_dialog.gd" id="1_dialog"]
[ext_resource type="Theme" path="res://resources/ui/wood_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/ui/advance_option.tscn" id="3_option"]
[ext_resource type="PackedScene" path="res://scenes/ui/confirm_dialog.tscn" id="4_confirm"]

[node name="AdvanceDialog" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_dialog")
option_scene = ExtResource("3_option")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.6)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(540, 0)
layout_mode = 2

[node name="Plate" type="PanelContainer" parent="Center/Panel"]
layout_mode = 2
theme_type_variation = &"InteriorPanel"

[node name="Content" type="VBoxContainer" parent="Center/Panel/Plate"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Title" type="Label" parent="Center/Panel/Plate/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "ADVANCE YOUR CLASS"
horizontal_alignment = 1

[node name="NoteLabel" type="Label" parent="Center/Panel/Plate/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"AccentLabel"
horizontal_alignment = 1
autowrap_mode = 3

[node name="OptionRow" type="HBoxContainer" parent="Center/Panel/Plate/Content"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 6

[node name="CloseButton" type="Button" parent="Center/Panel/Plate/Content"]
unique_name_in_owner = true
custom_minimum_size = Vector2(120, 0)
layout_mode = 2
size_flags_horizontal = 4
text = "CLOSE"

[node name="ConfirmDialog" parent="." instance=ExtResource("4_confirm")]
unique_name_in_owner = true
